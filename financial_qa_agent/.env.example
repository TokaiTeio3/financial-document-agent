# Default: synthetic documents, no remote model requests.
FINQA_DEMO_MODE=true
FINQA_DATA_ROOT=tests/fixtures/corpus
FINQA_INDEX_ROOT=runtime_index

# Set DEMO_MODE=false and provide a compatible endpoint to use real models.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINQA_PLANNER_MODEL=qwen3.7-max
FINQA_TOOL_MODEL=qwen3.7-flash

FINQA_TOP_K=10
FINQA_FINAL_RETRIES=2
FINQA_STRUCTURED_RETRIES=1
FINQA_REQUEST_TIMEOUT=120
FINQA_CHUNK_SIZE=900
FINQA_CHUNK_OVERLAP=120
FINQA_PAGE_OVERLAP=240
